# MUST HAVE for database configuration. Change these values outside local development.
POSTGRES_USER=nnaper
POSTGRES_PASSWORD=nnaper
POSTGRES_DB=nnaper_db
POSTGRES_PORT=5432

# MUST HAVE when running Python services outside Docker Compose.
# Compose builds the internal container URL from POSTGRES_* above.
DB_URL=postgresql://nnaper:nnaper@localhost:5432/nnaper_db

# MUST HAVE for browser access when using a non-default frontend origin.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# OPTIONAL: host ports exposed by Docker Compose.
API_PORT=8000
OSRM_PORT=5000
TILES_PORT=8080

# OPTIONAL: public URLs used by the browser runtime configuration.
API_PUBLIC_URL=http://localhost:8000
TILES_PUBLIC_URL=http://localhost:8080
OSRM_PUBLIC_URL=http://localhost:5000

# OPTIONAL: input map data and generated PMTiles file.
OSM_FILE_NAME=pomorskie.osm.pbf
PMTILES_FILE=pomorskie.pmtiles
OSM_DOWNLOAD_BASE_URL=https://download.geofabrik.de/europe/poland

# OPTIONAL: memory available to Planetiler during tile generation.
PLANETILER_JAVA_OPTS=-Xmx4g

# OPTIONAL: geocoding service and search area.
PHOTON_URL=https://photon.komoot.io
PHOTON_BBOX=14.1,53.9,19.9,55.9
PHOTON_SEARCH_LIMIT=50

# OPTIONAL: parser input, state, and output directories.
DATA_DIR=data
DATA_FILE=data/raw.txt
STATE_FILE=data/state.txt

# OPTIONAL: parser performance and GPS validation thresholds.
BATCH_SIZE=10000
MAX_HDOP=5.0
PREFERRED_HDOP=3.0
MAX_SPEED_KMH=500.0

# OPTIONAL: default profile created by the parser.
DEFAULT_PROFILE_USERNAME=admin
DEFAULT_PROFILE_NAME=samochód
DEFAULT_PROFILE_EMAIL_DOMAIN=local.dev
DEFAULT_PROFILE_PASSWORD_HASH=placeholder_hash